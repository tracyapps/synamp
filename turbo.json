{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "ani-cursor#build": {
      "outputs": ["built/**", "dist/**"]
    },
    "winamp-eqf#build": {
      "outputs": ["built/**", "dist/**"]
    },
    "webamp#build": {
      "dependsOn": ["ani-cursor#build", "winamp-eqf#build", "webamp#type-check"],
      "outputs": ["built/**"]
    },
    "ani-cursor#type-check": {},
    "winamp-eqf#type-check": {},
    "webamp#type-check": {
      "dependsOn": ["ani-cursor#build", "winamp-eqf#build"]
    },
    "ani-cursor#test": {
      "outputs": []
    },
    "winamp-eqf#test": {
      "outputs": []
    },
    "webamp#test": {
      "dependsOn": ["ani-cursor#build", "winamp-eqf#build"],
      "outputs": []
    },
    "webamp#integration-tests": {
      "dependsOn": ["ani-cursor#build", "winamp-eqf#build"],
      "outputs": []
    },
    "webamp#lint": {
      "dependsOn": ["ani-cursor#build", "winamp-eqf#build"]
    },
    "ani-cursor#lint": {},
    "winamp-eqf#lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
