{
  "id": "07-forget",
  "kind": "learning",
  "extends": "05-fast-learning.json",
  "title": "Forget — learning_reset marker clears the epoch's evidence (module level)",
  "stream": {
    "events_append": [
      { "signal": "learning_reset", "track": "", "at": "+25m", "detail": { "scope": "epoch" } }
    ]
  },
  "now": "+29m",
  "checks": {
    "adjust_zero": ["sample-034", "sample-024", "sample-040", "sample-026", "sample-028"],
    "hides_empty": true,
    "resolve": {
      "playlist_id": "pl-lab",
      "plan_phrase": "60 tracks, between 60 and 180 bpm",
      "identical_to_baseline": true
    }
  }
}
