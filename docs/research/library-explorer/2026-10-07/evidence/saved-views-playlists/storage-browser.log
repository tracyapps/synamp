### Ran Playwright code
```js
await (async page => {
 await page.goto('http://127.0.0.1:39822/#/library'); await page.reload();
 await page.getByRole('button',{name:'Views',exact:true}).click();
 const dialog=page.getByRole('dialog',{name:'Saved Library views'});
 await dialog.getByRole('textbox',{name:'View name'}).fill('Delete check');
 await dialog.getByRole('button',{name:'Save current view'}).click();
 await dialog.getByRole('button',{name:'Delete view Delete check'}).click();
 const after=await page.evaluate(()=>JSON.parse(localStorage.getItem('synamp-library-saved-views-v1')).views.length);
 if(after!==0) throw new Error('delete not persisted');
 await page.evaluate(()=>{window.originalSetItem=Storage.prototype.setItem;Storage.prototype.setItem=function(){throw new Error('Simulated storage quota')};});
 await dialog.getByRole('textbox',{name:'View name'}).fill('Quota view');
 await dialog.getByRole('button',{name:'Save current view'}).click();
 await dialog.getByRole('alert').filter({hasText:'Simulated storage quota'}).waitFor();
 const failedCount=await page.evaluate(()=>JSON.parse(localStorage.getItem('synamp-library-saved-views-v1')).views.length);
 await page.evaluate(()=>{Storage.prototype.setItem=window.originalSetItem;delete window.originalSetItem;});
 if(failedCount!==0)throw new Error('failed save mutated storage');
 await page.keyboard.press('Escape');
 return {checks:['Delete persists immediately','Storage failure preserves existing views and displays error','Escape closes native Views dialog']};
})(page);
```
