+  const fresh = deriveEpochPolicy(split, { now: t0 + 31 * 60_000, timezone: TZ });
+  assert.equal(fresh.adjust("X").value, 0); // the old epoch is closed — killed, not decayed
+  assert.equal(fresh.adjust("Y").value, 0);
+});
