# SynAmp deployment configuration.
# Copy to `.env` and edit. Never commit the real `.env`.

# --- library ---------------------------------------------------------------
# The SCANNED library root, not the share root. Synology shares live under
# /volume1/. Mounted read-only into the containers.
MUSIC_PATH=/volume1/music/library

# --- app state -------------------------------------------------------------
# Where the databases and caches live. This is the directory you back up.
# Keep it OUT of the music share, and never on a network mount.
DATA_DIR=/volume1/docker/synamp/data

# --- brain database --------------------------------------------------------
POSTGRES_USER=synamp
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=synamp
PLAYLIST_API_TOKEN=replace-with-a-long-random-token

# --- library core (Navidrome) ----------------------------------------------
CORE_PORT=4533
ND_SCANSCHEDULE=1h
ND_LOGLEVEL=info
TRANSCODE_CACHE=1GiB

# --- Last.fm scrobbling (optional) -----------------------------------------
# Create an API account at https://www.last.fm/api/account/create, paste the
# key and secret here, restart, then connect your profile from the SynAmp web
# app ("Listening history & Last.fm"). Leave empty to keep the feature off.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# The address you open SynAmp at (e.g. http://syd.tailnet.ts.net:8080), used
# for the Last.fm sign-in return trip. Optional; derived from the request.
PUBLIC_URL=

# --- missing-tracks list (MusicBrainz) ---------------------------------------
# MusicBrainz asks every app for a contact in its User-Agent. Your email or a
# URL; it is sent only to musicbrainz.org.
MUSICBRAINZ_CONTACT=

# --- organising the library (optional: the `librarian` profile) -----------
# The librarian is the only SynAmp service that may change the music files.
# It runs as this user so new folders get the right owner: `id <you>` on the NAS.
PUID=1026
PGID=100
# The whole music share (library/ + incoming/). The librarian mounts it as one,
# and keeps its journal in .synamp/ at the top (outside the scan root).
# On the Mac: RENAME_JOURNAL_PATH=/Volumes/music/.synamp/renames.jsonl
MUSIC_SHARE=/volume1/music
# New music waiting to be filed (drop files here, or drag them into the web app).
INCOMING_PATH=/volume1/music/incoming
# Largest single file the web app accepts, in MB.
UPLOAD_MAX_MB=2048

# --- edge ------------------------------------------------------------------
# Port the whole app is served on. Use 80/443 once a hostname (or Tailscale)
# is in front; 8080 avoids clashing with DSM's own web UI.
HTTP_PORT=8080
